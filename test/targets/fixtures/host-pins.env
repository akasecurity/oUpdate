# Pinned macOS host CLIs that a host runtime bundle installs: vmtool, ctrtool and the docker CLI. These run on the Mac host, not in the base image, so they live apart from pins.env (which parsePins reads).
# vmtool: the vmtool release, darwin arm64 only.
# Source: install-runtime.sh (VMTOOL=2.2.1) and the release's SHA256SUMS, read 2026-10-27.
VMTOOL_VERSION=2.2.1
# Download: https://github.com/example/vmtool/releases/download/v<VMTOOL_VERSION>/<VMTOOL_ASSET>
VMTOOL_ASSET=vmtool-2.2.1-Darwin-arm64.tar.gz
# Source: the line for that asset in the release SHA256SUMS (the installer checks it), read 2026-10-27.
VMTOOL_SHA256=9e9eacce88f37e185c346bad73aa6136f738d8cdf8c3bb23cd42b071824bc66e
# ctrtool: a single darwin arm64 binary.
# Source: install-runtime.sh (CTRTOOL=0.10.3), read 2026-10-27.
CTRTOOL_VERSION=0.10.3
# Download: https://github.com/example/ctrtool/releases/download/v<CTRTOOL_VERSION>/<CTRTOOL_ASSET>
CTRTOOL_ASSET=ctrtool-Darwin-arm64
# Source: the ctrtool-Darwin-arm64 line of the release sha256sum file, which equals the CTRTOOL_SHA in install-runtime.sh, read 2026-10-27.
CTRTOOL_SHA256=980ad8bf61a4ca370243f4cb41401a61276dcd2c2502bee7b9b86f9250169f34
# docker CLI: the static client tgz (only docker/docker is extracted).
# Source: install-runtime.sh (DOCKER=29.9.2), read 2026-10-27.
DOCKER_CLI_VERSION=29.9.2
# Download: https://download.docker.com/mac/static/stable/aarch64/docker-<DOCKER_CLI_VERSION>.tgz
DOCKER_CLI_ASSET=docker-29.9.2.tgz
# First-fetch pin: taken from the sha256 of the first download, NOT checked against an upstream sums file (Docker publishes none for this tgz). Read 2026-10-27.
DOCKER_CLI_SHA256=ea8a2ce5ac31f9f5f3fb711a7a485e1e46cc7a69798a629a70306f6e6af25b7a

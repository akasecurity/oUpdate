# Pinned macOS host runtime CLIs that a host runtime bundle installs for the standard agent account: lima, colima and the docker CLI. These run on the Mac host, not in the base image, so they live apart from pins.env (which parsePins reads).
# lima: the limactl/lima release, darwin arm64 only.
# Source: air runtime bundle install-runtime.sh (LIMA=2.2.1) and the release's SHA256SUMS, read 2026-10-27.
LIMA_VERSION=2.2.1
# Download: https://github.com/lima-vm/lima/releases/download/v<LIMA_VERSION>/<LIMA_ASSET>
LIMA_ASSET=lima-2.2.1-Darwin-arm64.tar.gz
# Source: the line for that asset in the release SHA256SUMS (the installer checks it), read 2026-10-27.
LIMA_SHA256=9e9eacce88f37e185c346bad73aa6136f738d8cdf8c3bb23cd42b071824bc66e
# colima: a single darwin arm64 binary.
# Source: install-runtime.sh (COLIMA=0.10.3), read 2026-10-27.
COLIMA_VERSION=0.10.3
# Download: https://github.com/abiosoft/colima/releases/download/v<COLIMA_VERSION>/<COLIMA_ASSET>
COLIMA_ASSET=colima-Darwin-arm64
# Source: the colima-Darwin-arm64 line of the release sha256sum file, which equals the COLIMA_SHA in install-runtime.sh, read 2026-10-27.
COLIMA_SHA256=980ad8bf61a4ca370243f4cb41401a61276dcd2c2502bee7b9b86f9250169f34
# docker CLI: the static client tgz (only docker/docker is extracted).
# Source: install-runtime.sh (DOCKER=29.9.2), read 2026-10-27.
DOCKER_CLI_VERSION=29.9.2
# Download: https://download.docker.com/mac/static/stable/aarch64/docker-<DOCKER_CLI_VERSION>.tgz
DOCKER_CLI_ASSET=docker-29.9.2.tgz
# First-fetch pin: taken from the sha256 of the first download, NOT checked against an upstream sums file (Docker publishes none for this tgz). Read 2026-10-27.
DOCKER_CLI_SHA256=ea8a2ce5ac31f9f5f3fb711a7a485e1e46cc7a69798a629a70306f6e6af25b7a

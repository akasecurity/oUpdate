{
  "logDir": "/srv/oupdate/log",
  "targets": [
    {
      "id": "sandbox-pins",
      "os": "linux",
      "reach": { "kind": "git", "repo": "/repo/example", "remote": "origin", "base": "main" },
      "schedule": "weekly:sun",
      "summaryTo": "/srv/oupdate/status/sandbox-pins.tsv",
      "legs": [
        {
          "kind": "pin-bump",
          "pinsPath": "sandbox/base/pins.env",
          "branchPrefix": "oupdate/",
          "proposalDir": "/srv/oupdate/proposals",
          "push": false,
          "cooldownDays": 2,
          "groups": [
            { "source": "npm", "name": "cli", "package": "@scope/cli", "versionKey": "CLI_VERSION", "integrity": {} }
          ]
        },
        {
          "kind": "pin-bump",
          "pinsPath": "sandbox/base/host-pins.env",
          "branchPrefix": "oupdate/",
          "proposalDir": "/srv/oupdate/proposals",
          "push": false,
          "cooldownDays": 2,
          "groups": [
            {
              "source": "github-release",
              "name": "vmtool",
              "repo": "example/vmtool",
              "tag": "v{v}",
              "versionKey": "VMTOOL_VERSION",
              "assets": { "VMTOOL_SHA256": "vmtool-{v}-Darwin-arm64.tar.gz" },
              "assetKeys": { "VMTOOL_ASSET": "vmtool-{v}-Darwin-arm64.tar.gz" }
            },
            {
              "source": "github-release",
              "name": "ctrtool",
              "repo": "example/ctrtool",
              "tag": "v{v}",
              "versionKey": "CTRTOOL_VERSION",
              "assets": { "CTRTOOL_SHA256": "ctrtool-Darwin-arm64" },
              "assetKeys": { "CTRTOOL_ASSET": "ctrtool-Darwin-arm64" }
            },
            {
              "source": "docker-static",
              "name": "docker-cli",
              "versionKey": "DOCKER_CLI_VERSION",
              "assetKey": "DOCKER_CLI_ASSET",
              "shaKey": "DOCKER_CLI_SHA256",
              "propose": false,
              "note": "no upstream sums; first-fetch pin, refresh the sha and the asset name by hand"
            }
          ]
        }
      ]
    }
  ]
}
